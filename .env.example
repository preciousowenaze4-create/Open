# SUPABASE CREDENTIALS (Project Settings -> API in Supabase Dashboard)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Optional for AI website generation (falls back cleanly if unset).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DESEC_API_TOKEN: Free Global DNS API Token from https://desec.io for live .dedyn.io domains
DESEC_API_TOKEN=""

# DYNV6_API_TOKEN: Optional free HTTP Token from https://dynv6.com/keys (Email signup only - No ID required) for .dynv6.net/.v6.rocks/.dns.army
DYNV6_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
